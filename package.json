{
  "name": "desafio-diario-estadisticas",
  "private": true,
  "version": "0.1.0",
  "description": "Statistics for the GeoGuessr Daily Challenge: score history, learning curves, per-region odds, exploration map and a friends leaderboard.",
  "type": "module",
  "scripts": {
    "dev": "npm run build:collector && vite",
    "build": "npm run build:collector && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:collector": "node scripts/build-collector.mjs",
    "build:geodata": "node scripts/build-geodata.mjs",
    "mock:geoguessr": "node scripts/run-ts.mjs scripts/mock-geoguessr.ts"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "idb-keyval": "^6.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.1",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-shape": "^3.1.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.0.0",
    "d3-geo": "^3.1.1",
    "esbuild": "^0.28.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
